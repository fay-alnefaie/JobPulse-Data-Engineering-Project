#======================================================
# JobPulse — Airflow platform bootstrap configuration
#======================================================

# --- Image / project paths (safe to leave as default) 
AIRFLOW_IMAGE_NAME=apache/airflow:3.3.1
AIRFLOW_PROJ_DIR=.

# --- Security keys (REQUIRED — generate your own, do not reuse these) ---
# Generate each with:
# python -c "from cryptography.fernet import Fernet;
# print(Fernet.generate_key().decode())"
FERNET_KEY= 
AIRFLOW__API_AUTH__JWT_SECRET=

# --- Local Airflow admin account (web UI login at 
# localhost:8080) 
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=change_me

# --- Optional: quick local package testing only, leave empty otherwise ---
_PIP_ADDITIONAL_REQUIREMENTS=

# --- Windows/WSL only: your local user profile path, used to mount
#     your personal ~/.dbt folder into the Airflow containers.
#     Example: C:\Users\yourname
USERPROFILE=
